# PR Movie — Environment Variables
# Copy this file to `.env` and replace placeholders with real values.

# ─── Database ───────────────────────────────────────
# PostgreSQL connection string (PostgreSQL >= 15 with Prisma 8)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prmovie"

# ─── GitHub API ─────────────────────────────────────
# Personal access token with `public_repo` scope for higher rate limits (5,000 req/hr)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN="ghp_your_github_token_here"

# ─── AI / Story Engine (Multi-Key Pools & Automatic Failover) ────────
# Provide one or multiple comma-separated keys to eliminate rate limits & timeouts.
# The server automatically cycles through keys and falls over seamlessly.
GEMINI_API_KEYS="AIzaSy...,AIzaSy...,AIzaSy..."
OPENAI_API_KEYS="sk-proj-...,sk-proj-..."

# Single key fallback aliases:
# GEMINI_API_KEY="AIzaSy..."
# OPENAI_API_KEY="sk-..."
# LLM_API_KEY="sk-..."

# ─── Redis Caching & Rate Limiting ──────────────────
# Upstash Redis REST credentials (or standard REDIS_URL for local Redis)
UPSTASH_REDIS_REST_URL="https://fit-civet-107969.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAaXBAAIgcDIxMjY5ZWRhMjZlNjQ0YWMzYmJjNGIzNDU2YWIwNDcwMw"
# REDIS_URL="redis://localhost:6379"

# ─── Authentication (Clerk) ─────────────────────────
# Clerk API keys for user authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ─── Application ────────────────────────────────────
# Public-facing app URL (used for share links and embeds)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
